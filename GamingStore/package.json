{
  "name": "gamingstore",
  "private": true,
  "version": "0.1.0",
  "description": "Professional digital gaming e-commerce platform (gift cards, game keys, top-up services) with TND/USD pricing, manual payment verification and digital delivery.",
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:prod": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:seed": "supabase db reset",
    "db:types": "supabase gen types typescript --local > src/lib/database.types.ts",
    "db:status": "supabase status",
    "env:local": "node scripts/env-local.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.3",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^14.10.1",
    "lucide-react": "^0.555.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.67.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.2.1",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.3",
    "eslint-config-next": "^16.4.5",
    "jsdom": "^27.4.0",
    "pg": "^8.23.1",
    "prettier": "^3.7.3",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
